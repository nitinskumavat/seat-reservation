# Copy to .env on the server and replace every value. Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=change-me
JWT_SECRET=change-me-at-least-32-bytes-long-0000
GRAFANA_ADMIN_PASSWORD=change-me
# Sizing. Defaults suit 2 vCPU / 8 GB. For 2 vCPU / 4 GB use APP_MEM_LIMIT=1536m and PG_SHARED_BUFFERS=256MB.
APP_MEM_LIMIT=2g
PG_SHARED_BUFFERS=512MB
# Smaller pools often do better on 2 vCPUs; try 10 if pool "pending" stays high under load.
DB_POOL_SIZE=20
